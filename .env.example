
# MySQL 根账号密码（首次启动生效）
MYSQL_ROOT_PASSWORD=root

# JWT 签名密钥（生产环境务必修改）
APP_JWT_SECRET=photography-server-jwt-secret-change-me


# 敏感信息（必须配置）
MYSQL_ROOT_PASSWORD=root
JWT_SECRET=your_jwt_secret_here

# MySQL 配置
MYSQL_DATABASE=photography
MYSQL_PORT=3306
MYSQL_DATA_DIR=./mysql/data
MYSQL_CONF_DIR=./mysql/conf
MYSQL_CHARSET=utf8mb4
MYSQL_COLLATION=utf8mb4_unicode_ci
MYSQL_HEALTH_INTERVAL=5s
MYSQL_HEALTH_TIMEOUT=5s
MYSQL_HEALTH_RETRIES=10

# Redis 配置
REDIS_VERSION=7-alpine
REDIS_PORT=6379
REDIS_DATA_DIR=./redis/data
REDIS_AOF=yes
REDIS_HEALTH_INTERVAL=5s
REDIS_HEALTH_TIMEOUT=5s
REDIS_HEALTH_RETRIES=10

# NATS 配置
NATS_VERSION=2.10-alpine
NATS_PORT=4222
NATS_MONITOR_PORT=8222
NATS_CONF_DIR=./nats/conf
NATS_DATA_DIR=./nats/data

# 后端配置
APP_PROFILE=dev
APP_MODE=release
APP_DB_HOST=mysql
APP_DB_PORT=3306
APP_DB_USER=root
APP_DB_NAME=photography
APP_REDIS_HOST=redis
APP_REDIS_PORT=6379
APP_NATS_URL=nats://nats:4222
APP_UPLOAD_DIR=/app/uploads
APP_LOG_LEVEL=warn
BACKEND_PORT=8080
BACKEND_CONTEXT=./photography-server
BACKEND_DOCKERFILE=Dockerfile
BACKEND_CONFIG_FILE=./photography-server/config/config.prod.yaml
UPLOADS_DIR=./uploads

# 前端配置
FRONTEND_PORT=8081
FRONTEND_CONTEXT=./photography-frontend
FRONTEND_DOCKERFILE=Dockerfile

# 时区
TZ=Asia/Shanghai