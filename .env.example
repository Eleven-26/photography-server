# ============================================================
# 环境变量模板（.env.example）
# 复制此文件为 .env 并填入真实值
# 注意：.env 文件禁止提交到 Git 仓库！
#
# 【本文件只保留 4 类变量，业务配置一律不在这里】
#   ① compose 基础设施变量（镜像版本/端口/数据卷/各中间件容器自身配置）
#   ② Nacos 连接自举信息（APP_NACOS_*）——连不上 Nacos 就取不到业务配置，必须外部提供
#   ③ 密文主密钥 KEK（APP_CONFIG_SECRET*）——解密 Nacos 里的 ENCv1 密文，存 Nacos 会死循环
#   ④ APP_PROFILE ——决定拉取哪个 data_id
# 业务配置（app / jwt / db / redis / nats / mongodb / log / upload / xxljob /
# elasticsearch / jaeger）全部在 Nacos：模板见 config/nacos/photography-server-<profile>.yaml，
# 改完用 ./scripts/nacos_publish.sh <profile> 推送（推送前自动校验无明文敏感值）。
# 应急排障仍可用 APP_* 环境变量临时覆盖（viper env 优先级最高），改回即恢复。
#
# 【易踩两条】
#   1) docker compose 会自动读取本文件做 ${VAR} 变量替换，因此这里写的 APP_NACOS_SERVER_ADDR
#      等值是【容器内视角】——compose 网络里用服务名 nacos:8848；本机 host 跑 Go 用
#      `make run-dev`，它会自动覆盖为 127.0.0.1:${NACOS_PORT}。
#   2) UPLOADS_DIR 必须与 Nacos 里 upload.dir 指向同一路径（默认 /app/uploads），
#      写错不会报错，但上传要么 500（目录不可写），要么不落进卷、容器一重建图片全丢。
# ============================================================

# ==================== 镜像版本 ====================
# 如：1.0.1
VERSION=your_image_version

# ==================== 敏感信息（必须修改） ====================
# 仅 MySQL 容器自身密码（基础设施）。Go 服务的业务凭据已全部进 Nacos（密文），不在这里。
MYSQL_ROOT_PASSWORD=your_mysql_root_password

# ==================== MySQL 配置 ====================
MYSQL_DATABASE=your_database_name
MYSQL_PORT=3306
MYSQL_DATA_DIR=./volume/mysql/data
MYSQL_CONF_DIR=./volume/mysql/conf
MYSQL_CHARSET=utf8mb4
MYSQL_COLLATION=utf8mb4_unicode_ci
MYSQL_HEALTH_INTERVAL=5s
MYSQL_HEALTH_TIMEOUT=5s
MYSQL_HEALTH_RETRIES=10
MYSQL_HEALTH_RETRIES=10

# ---- 首次初始化脚本（/docker-entrypoint-initdb.d/）----
# mysql 官方镜像仅在【数据卷为空】时按文件名字典序执行这些脚本 → 老库自动跳过，可放心保留。
# 路径相对 compose 所在目录（部署目录），与其它 ${*_CONTEXT} 口径一致。
MYSQL_INITDB_NACOS=./photography-server/docs/sql/initdb/01-nacos-schema.sql   # nacos 库表（13 张，Nacos 3.x 用）
MYSQL_INITDB_XXLJOB=./photography-server/docs/sql/initdb/02-xxl-job-tables.sql  # xxl_job 库表
MYSQL_INITDB_DDL=./photography-server/docs/sql/ddl.sql    # 业务库表（自带 CREATE DATABASE + USE）
MYSQL_INITDB_DML=./photography-server/docs/sql/dml.sql    # 业务初始数据

# ==================== Redis 配置 ====================
REDIS_VERSION=7-alpine
REDIS_PORT=6379
REDIS_DATA_DIR=./volume/redis/data
REDIS_AOF=yes
REDIS_HEALTH_INTERVAL=5s
REDIS_HEALTH_TIMEOUT=5s
REDIS_HEALTH_RETRIES=10

# ==================== NATS 配置 ====================
NATS_VERSION=2.10-alpine
NATS_PORT=4222
NATS_MONITOR_PORT=8222
NATS_CONF_DIR=./volume/nats/conf
NATS_DATA_DIR=./volume/nats/data
NATS_HEALTH_INTERVAL=5s
NATS_HEALTH_TIMEOUT=3s
NATS_HEALTH_RETRIES=12

# ==================== XXL-JOB 配置 ====================
XXLJOB_ADMIN_VERSION=latest
XXLJOB_ADMIN_EXPOSE_PORT=9100
XXLJOB_DB_HOST=mysql
XXLJOB_DB_PORT=3306
# 账号、密码可以用只有数据库xxl_job权限的账号
XXLJOB_DB_USER=root
XXLJOB_DB_NAME=xxl_job
# 可为空，但需与执行器一致
XXLJOB_ACCESS_TOKEN=your_xxl_job_access_token

# XXL-JOB 执行器配置（Go 服务）：已在 Nacos 的 xxljob 段，此处不再重复
# （Admin 容器自身的端口/数据库仍在上面的 XXLJOB_ADMIN_* / XXLJOB_DB_*）

# ==================== Elasticsearch / MongoDB 配置（可选组件，debug profile）====================
# 二者在 service / repository 层零引用，只被 /test/es|mongo/* 调试接口使用；prod 的 Nacos 配置
# 均为 enable=false。compose 已把它们归入 debug profile——默认 `docker compose up` 不启动，
# 也不再把它们作为 backend 的启动依赖（原 ES 的 service_healthy 会把后端启动一起拖住）。
# 本地需要联调时：docker compose --profile debug up -d（或 make docker-up-debug）。
#
# --- Elasticsearch ---
ES_VERSION=8.19.7
ES_PORT=9200
ES_DATA_DIR=./volume/elasticsearch/data
# Go 侧的 elasticsearch.enable / urls / 账号见 Nacos；应急覆盖用 APP_ELASTICSEARCH_*
# （段名 elasticsearch → APP_ELASTICSEARCH_*，旧名 APP_ES_* 不生效，勿用）

# --- MongoDB ---
MONGO_VERSION=7.0
MONGO_PORT=27017
MONGO_DATA_DIR=./volume/mongo/data
MONGO_ROOT_USERNAME=   # 留空则无认证
MONGO_ROOT_PASSWORD=
# Go 侧的 mongodb.enable / uri / database / 账号见 Nacos；应急覆盖用 APP_MONGODB_*
# （段名 mongodb → APP_MONGODB_*，旧名 APP_MONGO_* 不生效，勿用）

# ==================== SkyWalking 栈配置（SkyWalking 通道组件版本/端口） ====================
SW_OAP_VERSION=11.0.0
SW_UI_VERSION=horizon-1.0.0
SW_BDB_VERSION=0.11.0
SW_BDB_PORT=17912
SW_BDB_HTTP_PORT=17913
SW_BDB_DATA_DIR=./volume/skywalking/banyandb/data
SW_OAP_GRPC_PORT=11800
SW_OAP_QUERY_PORT=12800
SW_OAP_ADMIN_PORT=17128
SW_UI_PORT=9080
SW_UI_CONFIG_FILE=./volume/horizon/horizon.yaml   # Horizon UI 配置（OAP 地址/登录用户只从该文件读取，无 env 注入入口）
SW_OAP_JAVA_OPTS="-Xms512m -Xmx512m"         # OAP JVM 堆大小（与 compose 默认值一致，资源紧张时才需调）

# ==================== 后端链路追踪（两通道各自独立，勿同开，否则双 span/双上报） ====================
# 通道① SkyWalking-go(native)：构建注入 agent(SW_AGENT_ENABLE=true) 即启用，直连 OAP:11800，
#   无运行时开关；agent 上报地址等已固化到 agent.config 默认值（${ENV:default} 占位），
#   运行期仍可用同名 env（SW_AGENT_NAME / SW_AGENT_REPORTER_GRPC_BACKEND_SERVICE）覆盖。
# 通道② OTel→Jaeger：jaeger.enable=true + jaeger.endpoint=jaeger:4317（复用 OTel 埋点、
#   不注入 agent；存储 ClickHouse，Jaeger UI :16686 按 trace_id 检索）；native 注入构建时须保持 false。
# 开关/地址在 Nacos 的 jaeger 段（应急覆盖仍可用 APP_JAEGER_*，对应 config 的 jaeger 段）。
# 通道① 注入构建参数（与 Dockerfile ARG 同名透传，属于构建期变量，不走 Nacos）
SW_AGENT_ENABLE=false
SW_AGENT_VERSION=0.7.0
SW_AGENT_SERVICE=photography-server
SW_AGENT_BACKEND=skywalking-oap:11800

# ==================== Jaeger 通道（可选，存 ClickHouse） ====================
# Jaeger 2.20 官方配套 ClickHouse 26.x，两者版本需成对升级
JAEGER_VERSION=2.20.0
JAEGER_CONFIG_FILE=./volume/jaeger/config.yaml
# ClickHouse 存储是 Jaeger v2 的实验特性，默认关闭；只能走命令行开，配置文件里没有这个字段。
JAEGER_FEATURE_GATES=storage.clickhouse
JAEGER_OTLP_GRPC_PORT=4317
JAEGER_OTLP_HTTP_PORT=4318
JAEGER_UI_PORT=16686
CLICKHOUSE_VERSION=26.3-alpine
CLICKHOUSE_DB=jaeger
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_PORT=9000
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_DATA_DIR=./volume/clickhouse/data

# ==================== Nacos（唯一业务配置源，backend 硬依赖） ====================
# v3 控制台为独立端口：http://localhost:${NACOS_CONSOLE_PORT}/（容器内 8080）；v2 旧版为 http://localhost:8848/nacos
# ⚠️ Nacos 3.x 起用户表默认为空（不再预置 nacos/nacos）：首次部署必须初始化管理员，
#    且必须与下方 APP_NACOS_PASSWORD 一致。
#    ✅ 现已由一次性容器 nacos-init 自动完成（backend 会等它成功退出），无需再手点控制台：
#    它调用 POST /nacos/v3/auth/user/admin，仅在【尚无管理员】时生效；已存在则跳过、不改既有密码。
#    backend 的 Go SDK 只走用户名密码登录（不发 identity 头），未初始化会拉配置报
#    401「User not found」→ fail-fast 起不来。发布脚本可走 identity 兜底，backend 不行。
#    生产：初始化后到「权限控制 → 用户」改密/建专用账号，改完同步改本文件。
NACOS_VERSION=v3.2.4
NACOS_PORT=8848
NACOS_GRPC_PORT=9848   # 客户端 SDK 走 gRPC（= 8848+1000，偏移关系不可改）
NACOS_CONSOLE_PORT=8850 # 宿主访问 v3 控制台的端口（容器内 8080；不能用 8080——backend 已占用）
NACOS_AUTH_ENABLE=true
# 鉴权三件套：AUTH_ENABLE=true 时以下三项缺一，容器启动脚本 exit 255（报 NACOS_AUTH_IDENTITY_KEY must be set）
#   TOKEN = Base64(原始串 >=32 字符)，生成：echo -n '你的32位以上随机串' | base64
#   IDENTITY_KEY/VALUE = 服务端间识别头（standalone 也必填），Go 客户端不使用
# ⚠️ NACOS_AUTH_IDENTITY_VALUE 须与 APP_NACOS_IDENTITY_VALUE 取同值，否则发布脚本
#    的 identity 兜底通道失效（用户名密码通道仍可用）。
NACOS_AUTH_TOKEN=
NACOS_AUTH_IDENTITY_KEY=serverIdentity
NACOS_AUTH_IDENTITY_VALUE=
# ↑ 本值要与文件末「仅发布脚本使用」段的 APP_NACOS_IDENTITY_VALUE 保持一致（identity 兜底通道）
NACOS_JVM_XMS=256m
NACOS_JVM_XMX=512m

# ---- 存储后端：MySQL（替代 standelone 内嵌 Derby）----
# 为什么必须切：3.x 内嵌 Derby 落在【容器可写层】（本服务没有可写数据卷），
# 容器一 recreate 配置与注册信息全丢。切 MySQL 后由 mysql 容器的 initdb 建好 nacos 库表。
# 数据源 env 由官方镜像模板转成 spring.sql.init.platform / db.url.0（3.x 的键名，勿照抄 2.x）。
NACOS_DB_PLATFORM=mysql
NACOS_DB_HOST=mysql
NACOS_DB_PORT=3306
NACOS_DB_NAME=nacos
NACOS_DB_USER=root      # 生产建议改用仅 nacos 库权限的专用账号
# 密码不在此处：compose 复用 MYSQL_ROOT_PASSWORD 注入
# allowPublicKeyRetrieval 为 MySQL 8 caching_sha2_password 认证所需，勿删；含 & 故加引号
NACOS_DB_PARAM="characterEncoding=utf8&connectTimeout=1000&socketTimeout=3000&autoReconnect=true&useUnicode=true&useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true"

# ---- 一次性初始化容器 nacos-init（管理员初始化 + 业务配置发布）----
# 它跑完即退，backend 以 service_completed_successfully 等它退出码 0；
# 每次 up 都会重放，脚本内"管理员已存在/配置已一致"即跳过，等于每次 up 自动校准配置。
NACOS_INIT_ENABLE=true          # 置 false 则容器秒退（退出码 0，不阻塞 backend），调试期用
NACOS_INIT_FORCE_PUSH=false     # 远端配置与本地模板不一致时：false=保留远端并警告，true=强制覆盖
NACOS_INIT_TIMEOUT=180          # 等待 Nacos 就绪的最长秒数
NACOS_INIT_IMAGE=nacos/nacos-server:v3.2.4   # 复用 nacos 镜像（内含 bash+curl），升级时须与 NACOS_VERSION 一致
NACOS_INIT_SCRIPT=./photography-server/scripts/nacos_init.sh
NACOS_CONFIG_DIR=./photography-server/config/nacos   # 配置模板目录（photography-server-<profile>.yaml）

# ---- 后端接入 Nacos（compose 变量替换读本节） ----
# ⚠️ 本值是【容器内】视角：compose 网络里 backend 要用服务名 nacos:8848。
# 本机 host 跑 Go 时不能解析 nacos，`make run-dev` 会自动覆盖为 127.0.0.1:${NACOS_PORT}。
# 后端接入（必配）：Nacos 是唯一业务配置源，backend 启动必连（拉取失败 fail-fast）。
# 本地 config.yaml 仅为 bootstrap（仅 nacos 连接段）；业务配置在 Nacos 控制台发布
# （data_id=photography-server-${APP_PROFILE}.yaml 由 bootstrap 占位符拼接，内容模板见 config/nacos/photography-server-*.yaml，未发布则启动失败）。
APP_NACOS_SERVER_ADDR=nacos:8848   # 容器内互联用服务名；本机 docker run 用 127.0.0.1:8848
APP_NACOS_NAMESPACE=   # 留空 = public
APP_NACOS_GROUP=DEFAULT_GROUP
# ⚠️ 首次部署须先在控制台初始化管理员 nacos 的密码，且与本行密码一致（详见上方 Nacos 段）
APP_NACOS_USERNAME=   # 服务端开鉴权时必填
APP_NACOS_PASSWORD=
APP_NACOS_SERVICE_NAME=photography-server
# APP_NACOS_DATA_ID=photography-server-prod.yaml
# ↑ 一般不用填：缺省由 compose 拼成 photography-server-${APP_PROFILE}.yaml，跟随 APP_PROFILE。
#   只有 data_id 刻意不跟随 APP_PROFILE 时才取消注释并写【已解析的字面值】
#   （env 文件的值不会被递归展开，写成 ${APP_PROFILE} 会原样传给容器）。
# 注册 IP，留空自动探测（容器内为容器 IP）
APP_NACOS_REGISTER_IP=
NACOS_CLIENT_CACHE_DIR=./volume/nacos-client/cache   # backend 容器内 SDK 快照持久化目录（挂载宿主）
# 以下 SDK 可调项为可选：env 能覆盖的前提是 config.yaml 的 nacos 段存在对应 key（已补齐）
APP_NACOS_TIMEOUT_MS=    # 请求超时，默认 5000
APP_NACOS_CACHE_DIR=     # 本地快照目录，默认 .nacos/cache
APP_NACOS_LOG_LEVEL=     # SDK 日志级别，默认 warn
APP_NACOS_CLUSTER_NAME=  # 集群名，默认 DEFAULT
APP_NACOS_WEIGHT=        # 注册权重，默认 1
# 配置拉取重试（启动自举阶段，见 infrastructure.FetchConfigWithRetry）：
# 避免 Nacos 冷启期 backend 被 restart 策略拉着快速重启成环；超时后仍失败才 fail-fast。
APP_NACOS_FETCH_RETRIES=8          # 最大尝试次数（含首次）
APP_NACOS_FETCH_INTERVAL_MS=3000   # 首次退避间隔（毫秒），每次翻倍，上限 15s
# 发布脚本 scripts/nacos_publish.sh 专用（非 backend 运行期变量，不进容器）
NACOS_PUBLISH_SERVER=http://127.0.0.1:8848   # 脚本推送目标地址（宿主访问填宿主映射端口）
APP_NACOS_APP_NAME=photography-server        # 配置的“归属应用”元数据（Nacos appName 字段）
APP_NACOS_IDENTITY_KEY=serverIdentity        # 推送脚本的免登录兜底通道（与容器 NACOS_AUTH_IDENTITY_KEY 同名）
APP_NACOS_IDENTITY_VALUE=                    # 仅本地 dev 用；等于管理员权限，勿填生产值
# 配置密文主密钥（KEK）：仅用于解密 Nacos 模板里的 ENCv1: 密文。
# 绝不能放进 Nacos（解密 Nacos 配置需要它，存进去就是死循环），只能来自部署环境的“信任根”。
# 生产推荐 APP_CONFIG_SECRET_FILE（Docker/K8s secret 挂载）；本地 dev 可用 APP_CONFIG_SECRET。
# 生成：go run ./cmd/configctl keygen    轮换期旧密钥：APP_CONFIG_SECRET_PREV（只解密）
APP_CONFIG_SECRET_FILE=                      # 例：/run/secrets/config_secret（容器只读挂载）
APP_CONFIG_SECRET=                           # base64 44 字符 / hex 64 字符 / 原文 32 字符
# 密钥轮换期临时并存
APP_CONFIG_SECRET_PREV=

# ==================== Backend（Go 服务）部署变量 ====================
# 业务配置（app.mode / jwt / db / redis / nats / mongodb / log / upload / xxljob /
# elasticsearch / jaeger）全在 Nacos，不在此处注入。
APP_PROFILE=prod   # 决定拉取哪个 data_id：photography-server-${APP_PROFILE}.yaml

BACKEND_PORT=8080
BACKEND_CONTEXT=./photography-server
BACKEND_DOCKERFILE=Dockerfile
# 容器内挂载的 bootstrap 配置（只含 nacos 连接段）；不要指向 config.prod.yaml——该文件已删除
BACKEND_CONFIG_FILE=./photography-server/config/config.yaml
# Go 构建标签（传给 Dockerfile --build-arg）：留空 = 生产纯净二进制，不含基础设施调试接口
# （/test/redis|nats|es|mongo|jaeger）；容器内需要这些调试接口时设为 debug 后重新 build。
# 注：本地 make run / make build 默认带 debug 标签（见 Makefile 的 GO_TAGS）。
GO_BUILD_TAGS=
# 宿主目录 → 容器 /app/uploads。⚠️ 必须与 Nacos 里 upload.dir 一致（prod/test 模板已改为 /app/uploads）
UPLOADS_DIR=./volume/uploads
# 数据卷统一落在 ./volume/ 下（已在 .gitignore 忽略），容器首启会自动创建。

# ==================== Frontend（Vue3 服务）配置 ====================
FRONTEND_PORT=8081
FRONTEND_CONTEXT=./photography-frontend
FRONTEND_DOCKERFILE=Dockerfile

# ==================== h5 站点（客户端 · SLOT 摄影预约）====================
# 两阶段构建：node:20-alpine 编译 → nginx:1.27-alpine 托管；产物目录 dist/build/h5
H5_PORT=8082
H5_CONTEXT=./photography-h5
H5_DOCKERFILE=Dockerfile

# ==================== wechat 站点（员工端 · SLOT 摄影师端）====================
# 仅 H5 形态入容器；微信小程序由微信开发者工具上传，不走 compose
WECHAT_PORT=8083
WECHAT_CONTEXT=./photography-wechat
WECHAT_DOCKERFILE=Dockerfile

# ==================== 时区 ====================
TZ=Asia/Shanghai

# ============================================================
# 低配服务器（2核2G）裁剪清单
#
# 默认编排一次拉起 14 个容器，空闲内存约 4.2GB；2核2G 必须裁到核心栈（约 1.0~1.2GB）：
#
#   1) Nacos 侧设开关（config/nacos/photography-server-<profile>.yaml）：
#        xxljob.enable: false       # 省约 500MB —— Go 侧目前只有 job.test / job.health_check
#                                   #   两个占位任务，关掉不影响任何业务；InitXxlJob 会打一行
#                                   #   "xxl-job disabled, skipping" 后直接返回，不阻塞启动
#        jaeger.enable: false       # 省约 750MB —— 纯运维观测，关掉业务无感（默认已 false）
#        elasticsearch.enable / mongodb.enable: false   # 默认已是 false
#   2) 本文件调小 JVM / 关掉可选组件容器：
#        NACOS_JVM_XMS=128m / NACOS_JVM_XMX=256m        # Nacos 约 700MB → 约 400MB
#        SW_OAP_JAVA_OPTS=-Xms256m -Xmx256m
#   3) MySQL 启动参数加 --performance-schema=off       # 省 200~300MB
#   4) 启动时只起核心服务，且注意 backend 的 depends_on：
#        docker compose up -d mysql redis nats nacos backend frontend h5 wechat
#      ⚠️ backend 的 depends_on 挂着 xxl-job-admin 与 skywalking-oap，直接 up backend 会把它们
#         连带拉起（要么先注释掉这两条 depends_on，要么加 --no-deps 并自行确保依赖已就绪）。
#   5) ⚠️ 不要在 2核2G 机器上构建镜像：docker compose build 要跑 Go 编译 + 3 个前端 vite 构建，
#      峰值 4G+ 必 OOM。应在本地/CI 构建并推送镜像仓库，服务器只 docker compose pull。
#
# 其余参考：磁盘 40GB SSD 起步（最小栈镜像约 1.5GB，加 MySQL 数据与 volume/uploads 图片只增不减）；
# 带宽 3~5Mbps 起（H5/小程序要加载封面、图集、交付成片），上传方向留够（后端单文件上限 100MB）。
# ============================================================