# ============================================================
# 环境变量模板（.env.example）
# 复制此文件为 .env 并填入真实值
# 注意：.env 文件禁止提交到 Git 仓库！
# ============================================================

# ==================== 镜像版本 ====================
VERSION=your_image_version

# ==================== 敏感信息（必须修改） ====================
MYSQL_ROOT_PASSWORD=your_mysql_root_password
APP_JWT_SECRET=your_jwt_secret_key

# ==================== MySQL 配置 ====================
MYSQL_DATABASE=your_database_name
MYSQL_PORT=3306
MYSQL_DATA_DIR=./volume/mysql/data
MYSQL_CONF_DIR=./volume/mysql/conf
MYSQL_CHARSET=utf8mb4
MYSQL_COLLATION=utf8mb4_unicode_ci
MYSQL_HEALTH_INTERVAL=5s
MYSQL_HEALTH_TIMEOUT=5s
MYSQL_HEALTH_RETRIES=10

# ==================== Redis 配置 ====================
REDIS_VERSION=7-alpine
REDIS_PORT=6379
REDIS_DATA_DIR=./volume/redis/data
REDIS_AOF=yes
REDIS_HEALTH_INTERVAL=5s
REDIS_HEALTH_TIMEOUT=5s
REDIS_HEALTH_RETRIES=10

# ==================== NATS 配置 ====================
NATS_VERSION=2.10-alpine
NATS_PORT=4222
NATS_MONITOR_PORT=8222
NATS_CONF_DIR=./volume/nats/conf
NATS_DATA_DIR=./volume/nats/data

# ==================== XXL-JOB 配置 ====================
XXLJOB_ADMIN_VERSION=latest
XXLJOB_ADMIN_EXPOSE_PORT=9100
XXLJOB_DB_HOST=mysql
XXLJOB_DB_PORT=3306
XXLJOB_DB_USER=root
XXLJOB_DB_NAME=xxl_job
XXLJOB_ACCESS_TOKEN=your_xxl_job_access_token   # 可为空，但需与执行器一致

# XXL-JOB 执行器配置（Go 服务）
APP_XXLJOB_ENABLE=true
APP_XXLJOB_SERVER_ADDR=http://127.0.0.1:9100   # 宿主机访问 Admin
# 若 Go 服务在容器内，改为 http://xxl-job-admin:8080
APP_XXLJOB_EXECUTOR_IP=127.0.0.1   # Admin 回调执行器的 IP，宿主机可用 127.0.0.1 或 host.docker.internal
APP_XXLJOB_EXECUTOR_PORT=9999
APP_XXLJOB_REGISTRY_KEY=photography-server
APP_XXLJOB_LOG_DIR=./logs/xxl-job

# ==================== Elasticsearch 配置 ====================
ES_VERSION=8.19.7
ES_PORT=9200
ES_DATA_DIR=./volume/elasticsearch/data

# 变量名必须与 viper 映射一致：段名 elasticsearch → APP_ELASTICSEARCH_*（旧名 APP_ES_* 不生效，勿用）
APP_ELASTICSEARCH_ENABLE=false
APP_ELASTICSEARCH_URLS=http://elasticsearch:9200   # 多地址逗号分隔
APP_ELASTICSEARCH_USERNAME=
APP_ELASTICSEARCH_PASSWORD=

# ==================== MongoDB 配置 ====================
MONGO_VERSION=7.0
MONGO_PORT=27017
MONGO_DATA_DIR=./volume/mongo/data
MONGO_ROOT_USERNAME=   # 留空则无认证
MONGO_ROOT_PASSWORD=

# 段名 mongodb → APP_MONGODB_*（旧名 APP_MONGO_* 不生效，勿用）
APP_MONGODB_ENABLE=false
APP_MONGODB_URI=mongodb://mongo:27017
APP_MONGODB_DATABASE=photography
APP_MONGODB_USERNAME=
APP_MONGODB_PASSWORD=

# ==================== SkyWalking 栈配置（SkyWalking 通道组件版本/端口） ====================
SW_OAP_VERSION=11.0.0
SW_UI_VERSION=horizon-1.0.0
SW_BDB_VERSION=0.11.0
SW_BDB_PORT=17912
SW_BDB_HTTP_PORT=17913
SW_BDB_DATA_DIR=./volume/skywalking/banyandb/data
SW_OAP_GRPC_PORT=11800
SW_OAP_QUERY_PORT=12800
SW_OAP_ADMIN_PORT=17128
SW_UI_PORT=9080
SW_UI_CONFIG_FILE=./volume/horizon/horizon.yaml   # Horizon UI 配置（OAP 地址/登录用户只从该文件读取，无 env 注入入口）
SW_OAP_JAVA_OPTS=-Xms512m -Xmx512m         # OAP JVM 堆大小（与 compose 默认值一致，资源紧张时才需调）

# ==================== 后端链路追踪（两通道各自独立，勿同开，否则双 span/双上报） ====================
# 通道① SkyWalking-go(native)：构建注入 agent(SW_AGENT_ENABLE=true) 即启用，直连 OAP:11800，
#   无运行时开关；agent 上报地址等已固化到 agent.config 默认值（${ENV:default} 占位），
#   运行期仍可用同名 env（SW_AGENT_NAME / SW_AGENT_REPORTER_GRPC_BACKEND_SERVICE）覆盖。
# 通道② OTel→Jaeger：APP_JAEGER_ENABLE=true + APP_JAEGER_ENDPOINT=jaeger:4317（复用 OTel 埋点、
#   不注入 agent；存储 ClickHouse，Jaeger UI :16686 按 trace_id 检索）；native 注入构建时须保持 false。
# APP_JAEGER_* 对应 config 的 jaeger 段（OTel exporter 开关/地址）。
APP_JAEGER_ENABLE=false
APP_JAEGER_ENDPOINT=jaeger:4317
APP_JAEGER_SERVICE=photography-server
APP_JAEGER_INSTANCE=   # 留空默认取 hostname
# 通道① 注入构建参数（与 Dockerfile ARG 同名透传）
SW_AGENT_ENABLE=false
SW_AGENT_VERSION=0.7.0
SW_AGENT_SERVICE=photography-server
SW_AGENT_BACKEND=skywalking-oap:11800

# ==================== Jaeger 通道（可选，存 ClickHouse） ====================
JAEGER_VERSION=2.18.0
JAEGER_CONFIG_FILE=./volume/jaeger/config.yaml
JAEGER_OTLP_GRPC_PORT=4317
JAEGER_OTLP_HTTP_PORT=4318
JAEGER_UI_PORT=16686
CLICKHOUSE_VERSION=24.8
CLICKHOUSE_DB=jaeger
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_PORT=9000
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_DATA_DIR=./volume/clickhouse/data

# ==================== Nacos（唯一业务配置源，backend 硬依赖） ====================
# v3 控制台为独立端口：http://localhost:${NACOS_CONSOLE_PORT}/（容器内 8080）；v2 旧版为 http://localhost:8848/nacos
# 默认账号 admin/nacos（若首次登录提示初始化密码按提示操作；生产务必 NACOS_AUTH_ENABLE=true 并改密）
NACOS_VERSION=v3.2.4
NACOS_PORT=8848
NACOS_GRPC_PORT=9848   # 客户端 SDK 走 gRPC（= 8848+1000，偏移关系不可改）
NACOS_CONSOLE_PORT=8850 # 宿主访问 v3 控制台的端口（容器内 8080；不能用 8080——backend 已占用）
NACOS_AUTH_ENABLE=true
# 鉴权三件套：AUTH_ENABLE=true 时以下三项缺一，容器启动脚本 exit 255（报 NACOS_AUTH_IDENTITY_KEY must be set）
# TOKEN=Base64(原始串>=32字符)，生成：echo -n '你的32位以上随机串' | base64
# IDENTITY_KEY/VALUE 为服务端间识别头（standalone 也必填），Go 客户端不使用
NACOS_AUTH_TOKEN=
NACOS_AUTH_IDENTITY_KEY=serverIdentity
NACOS_AUTH_IDENTITY_VALUE=
NACOS_JVM_XMS=256m
NACOS_JVM_XMX=512m
# 后端接入（必配）：Nacos 是唯一业务配置源，backend 启动必连（拉取失败 fail-fast）。
# 本地 config.yaml 仅为 bootstrap（仅 nacos 连接段）；业务配置在 Nacos 控制台发布
# （data_id 见 APP_NACOS_DATA_ID，内容模板见 config/nacos/photography-server-*.yaml，未发布则启动失败）。
APP_NACOS_SERVER_ADDR=nacos:8848   # 容器内互联用服务名；本机 docker run 用 127.0.0.1:8848
APP_NACOS_NAMESPACE=   # 留空 = public
APP_NACOS_GROUP=DEFAULT_GROUP
APP_NACOS_DATA_ID=photography-server-prod.yaml   # bootstrap 默认 photography-server-${profile}.yaml，此处显式覆盖
APP_NACOS_USERNAME=   # 服务端开鉴权时必填
APP_NACOS_PASSWORD=
APP_NACOS_SERVICE_NAME=photography-server
APP_NACOS_REGISTER_IP=   # 注册 IP，留空自动探测（容器内为容器 IP）
NACOS_CLIENT_CACHE_DIR=./volume/nacos-client/cache   # backend 容器内 SDK 快照持久化目录（挂载宿主）
# 以下 SDK 可调项为可选：env 能覆盖的前提是 config.yaml 的 nacos 段存在对应 key（已补齐）
APP_NACOS_TIMEOUT_MS=    # 请求超时，默认 5000
APP_NACOS_CACHE_DIR=     # 本地快照目录，默认 .nacos/cache
APP_NACOS_LOG_LEVEL=     # SDK 日志级别，默认 warn
APP_NACOS_CLUSTER_NAME=  # 集群名，默认 DEFAULT
APP_NACOS_WEIGHT=        # 注册权重，默认 1

# ==================== Backend（Go 服务）配置 ====================
APP_APP_MODE=release   # app.mode 的 env 名为 APP_APP_MODE（段名 app + 键名 mode 拼接；旧名 APP_MODE 不生效）
APP_PROFILE=prod

APP_DB_HOST=mysql
APP_DB_PORT=3306
APP_DB_USER=root
APP_DB_PASSWORD=${MYSQL_ROOT_PASSWORD}   # 与 MySQL root 密码保持一致；compose 部署下由 MYSQL_ROOT_PASSWORD 注入容器（compose 未配 env_file，本变量仅用于 docker run 独立部署）
APP_DB_NAME=photography

APP_REDIS_ADDR=redis:6379   # redis.addr 是单字段 host:port（旧名 APP_REDIS_HOST/PORT 不生效）

APP_NATS_URL=nats://nats:4222

APP_UPLOAD_DIR=./app/uploads
APP_LOG_LEVEL=warn

BACKEND_PORT=8080
BACKEND_CONTEXT=./photography-server
BACKEND_DOCKERFILE=Dockerfile
BACKEND_CONFIG_FILE=./photography-server/config/config.prod.yaml
UPLOADS_DIR=./uploads

# ==================== Frontend（Vue3 服务）配置 ====================
FRONTEND_PORT=8081
FRONTEND_CONTEXT=./photography-frontend
FRONTEND_DOCKERFILE=Dockerfile

# ==================== 时区 ====================
TZ=Asia/Shanghai